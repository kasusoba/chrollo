DISCORD_TOKEN=xxx
DISCORD_CLIENT_ID=xxx
DISCORD_GUILD_ID=xxx
# Your Discord user ID. Bot DMs this account when Google, auth or the album breaks or recovers
DISCORD_OWNER_ID=xxx
# Port for the OAuth callback server (host + container)
PORT=5000
GOOGLE_CLIENT_ID=xxx-xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
# Callback used when /auth is opened from another device (e.g. through Tailscale).
# Opening http://localhost:<PORT>/auth always uses http://localhost:<PORT>/auth/callback.
# Add both URIs to the OAuth client in Google Cloud Console.
GOOGLE_REDIRECT_URI=https://chrollo.<tailnet>.ts.net/auth/callback
SESSION_SECRET=xxx
# Optional: host folder for temp media files (default ./tmp)
# TMP_DIR=/mnt/hdd/chrollo-tmp
# Optional: minutes between background health checks (default 10)
# HEALTH_CHECK_INTERVAL_MINUTES=10
